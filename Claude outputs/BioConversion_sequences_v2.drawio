        <mxCell id="alt1-a" value="[email déjà utilisé]" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontStyle=2;fontColor=#0033CC;" vertex="1" parent="1"><mxGeometry x="74" y="548" width="870" height="20" as="geometry" /></mxCell>
        <mxCell id="alt1-t" value="Erreur 400 - Email déjà utilisé" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="94" y="570" width="500" height="20" as="geometry" /></mxCell>
        <mxCell id="alt1-b" value="[mot de passe trop faible]" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontStyle=2;fontColor=#0033CC;" vertex="1" parent="1"><mxGeometry x="74" y="598" width="870" height="20" as="geometry" /></mxCell>
        <mxCell id="alt1-t2" value="Erreur 400 - Mot de passe trop faible" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="94" y="620" width="500" height="20" as="geometry" /></mxCell>
        <mxCell id="note-offline" value="⏸ ÉTAPE HORS PLATEFORME : le Producteur suit la formation en présentiel (obligatoire avant activation)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;verticalAlign=middle;arcSize=10;" vertex="1" parent="1"><mxGeometry x="60" y="670" width="900" height="44" as="geometry" /></mxCell>
        <mxCell id="s7" value="POST /admin/formations/{formationId}/participants (producteurId)" style="endArrow=block;endFill=1;html=1;strokeColor=#000000;fontSize=11;labelBackgroundColor=#ffffff;align=center;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="880" y="734" as="sourcePoint" /><mxPoint x="400" y="734" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="s8" value="UPDATE producteurs SET formation_id = ?  (traçabilité formation)" style="endArrow=block;endFill=1;html=1;strokeColor=#000000;fontSize=11;labelBackgroundColor=#ffffff;align=center;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="400" y="789" as="sourcePoint" /><mxPoint x="640" y="789" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="s9" value="OK" style="endArrow=open;endFill=0;dashed=1;html=1;strokeColor=#000000;fontSize=11;labelBackgroundColor=#ffffff;align=center;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="640" y="844" as="sourcePoint" /><mxPoint x="400" y="844" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="s10" value="PUT /admin/producteurs/{id}/activer  (après vérification manuelle de la pièce d'identité)" style="endArrow=block;endFill=1;html=1;strokeColor=#000000;fontSize=11;labelBackgroundColor=#ffffff;align=center;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="880" y="899" as="sourcePoint" /><mxPoint x="400" y="899" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="s11" value="UPDATE producteurs SET statut_verification_cnib = 'VERIFIE'" style="endArrow=block;endFill=1;html=1;strokeColor=#000000;fontSize=11;labelBackgroundColor=#ffffff;align=center;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="400" y="954" as="sourcePoint" /><mxPoint x="640" y="954" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="s12" value="compte activé" style="endArrow=open;endFill=0;dashed=1;html=1;strokeColor=#000000;fontSize=11;labelBackgroundColor=#ffffff;align=center;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="640" y="1009" as="sourcePoint" /><mxPoint x="400" y="1009" as="targetPoint" /></mxGeometry></mxCell>
