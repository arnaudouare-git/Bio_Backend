        <mxCell id="s1" value="POST /auth/inscription (nom, prenom, email, motDePasse, telephone, documentIdentiteRef)" style="endArrow=block;endFill=1;html=1;strokeColor=#000000;fontSize=11;labelBackgroundColor=#ffffff;align=center;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="160" y="190" as="sourcePoint" /><mxPoint x="400" y="190" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="s2" value="SELECT * FROM utilisateurs WHERE email = ?" style="endArrow=block;endFill=1;html=1;strokeColor=#000000;fontSize=11;labelBackgroundColor=#ffffff;align=center;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="400" y="245" as="sourcePoint" /><mxPoint x="640" y="245" as="targetPoint" /></mxGeometry></mxCell>
